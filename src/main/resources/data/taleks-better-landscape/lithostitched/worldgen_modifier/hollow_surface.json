{
  "type": "lithostitched:set_material_rule",
  "priority": 900,
  "target_rules": "minecraft:overworld",
  "material_rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:biome",
      "biome_is": [
        "minecraft:forest",
        "minecraft:birch_forest",
        "minecraft:old_growth_birch_forest",
        "minecraft:flower_forest",
        "minecraft:taiga",
        "minecraft:old_growth_pine_taiga",
        "minecraft:old_growth_spruce_taiga",
        "minecraft:dark_forest"
      ]
    },
    "then_run": {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:noise_threshold",
        "noise": "taleks-better-landscape:hollow_zone",
        "min_threshold": 0.22,
        "max_threshold": 100000000.0
      },
      "then_run": {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:stone_depth",
          "offset": 0,
          "surface_type": "floor",
          "add_surface_depth": false,
          "secondary_depth_range": 0
        },
        "then_run": {
          "type": "minecraft:sequence",
          "sequence": [
            {
              "type": "minecraft:condition",
              "if_true": {
                "type": "minecraft:noise_threshold",
                "noise": "taleks-better-landscape:hollow_path",
                "min_threshold": -0.035,
                "max_threshold": 0.035
              },
              "then_run": {
                "type": "minecraft:block",
                "result_state": "minecraft:gravel"
              }
            },
            {
              "type": "minecraft:condition",
              "if_true": {
                "type": "minecraft:above_preliminary_surface"
              },
              "then_run": {
                "type": "minecraft:condition",
                "if_true": {
                  "type": "minecraft:water",
                  "offset": -1,
                  "surface_depth_multiplier": 0,
                  "add_stone_depth": false
                },
                "then_run": {
                  "type": "minecraft:condition",
                  "if_true": {
                    "type": "minecraft:noise_threshold",
                    "noise": "taleks-better-landscape:hollow_path",
                    "min_threshold": -0.09,
                    "max_threshold": 0.09
                  },
                  "then_run": {
                    "type": "minecraft:block",
                    "result_state": "minecraft:moss_block"
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
